@model LostAndFound.Models.Item

@{
    ViewData["Title"] = "แจ้งของหาย / พบของ";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>แจ้งของหาย / แจ้งพบของ</h2>
    <hr />
    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">ชื่อสิ่งของ</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">ประเภท</label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<LostAndFound.Models.ItemType>()"></select>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">หมวดหมู่</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                <option value="">-- เลือกหมวดหมู่ --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">รายละเอียดเพิ่มเติม</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">สถานที่พบ/ทำหาย</label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StudentId" class="form-label">รหัสนักศึกษาผู้แจ้ง</label>
            <input asp-for="StudentId" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">วันที่และเวลาที่เกิดเหตุ</label>
            <input asp-for="EventDate" type="datetime-local" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">อัปโหลดรูปภาพ</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">ยกเลิก</a>
            <button type="submit" class="btn btn-primary">บันทึกข้อมูล</button>
        </div>
    </form>
</div>