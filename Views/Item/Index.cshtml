@model IEnumerable<LostAndFound.Models.Item>

@{
    ViewData["Title"] = "รายการของหาย / ของที่พบ";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam"></i> รายการของหายและของที่พบ</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> แจ้งของหาย / แจ้งพบของ</a>
    </div>

    <!-- ฟอร์มค้นหา -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <input type="text" name="searchString" class="form-control" placeholder="ค้นหาชื่อสิ่งของ หรือ สถานที่..." value="@Context.Request.Query["searchString"]" />
        </div>
        <div class="col-md-4">
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<LostAndFound.Models.ItemType>()">
                <option value="">-- ประเภททั้งหมด --</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> ค้นหา</button>
        </div>
    </form>

    <!-- การ์ดแสดงรายการ -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-light text-center py-5 text-muted">ไม่มีรูปภาพ</div>
                    }
                    <div class="card-body">
                        <span class="badge @(item.Type == LostAndFound.Models.ItemType.Lost ? "bg-danger" : "bg-success") mb-2">
                            @(item.Type == LostAndFound.Models.ItemType.Lost ? "ของหาย" : "พบของ")
                        </span>
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-truncate">@item.Description</p>
                        <ul class="list-unstyled text-muted small">
                            <li><strong>สถานที่:</strong> @item.Location</li>
                            <li><strong>วันที่:</strong> @item.EventDate.ToString("dd/MM/yyyy HH:mm")</li>
                            <li><strong>หมวดหมู่:</strong> @(item.Category?.Name ?? "ทั่วไป")</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                        <small class="text-muted">รหัสนักศึกษา: @item.StudentId</small>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('คุณแน่ใจหรือไม่ว่าต้องการลบรายการนี้?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">ลบ</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>